# ADOR systemd unit TEMPLATE (design doc 12a) - installed by install-ubuntu.sh,
# which replaces __ADOR_DIR__ (the 04_Software checkout) and __ADOR_USER__.
# Logs go to journald: journalctl -u ador -f

[Unit]
Description=ADOR - Agentic Delivery Orchestrator (poll loop)
Documentation=file://__ADOR_DIR__/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__ADOR_USER__
WorkingDirectory=__ADOR_DIR__
# Secrets: OS-level EnvironmentFile is preferred on a server (design 12b).
# The leading "-" makes it optional - ADOR also reads .env from the working
# directory itself, and glab/gh host auth may cover everything.
EnvironmentFile=-__ADOR_DIR__/.env
ExecStart=__ADOR_DIR__/.venv/bin/ador -c config.toml run --loop
# The poll loop is designed to run forever; restart on crashes, with a pause
# so a broken config cannot hot-loop. The single-instance lock (.ador/ador.lock)
# additionally guarantees no second poller on the same store.
Restart=on-failure
RestartSec=30
# Hardening: ADOR needs its checkout (state store, worktrees) and the docker
# socket, nothing else system-wide.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
