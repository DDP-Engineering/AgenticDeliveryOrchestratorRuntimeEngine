# =============================================================================
# ADOR executor image (ador-executor:latest)
#
# Base tooling baked in ONCE (design doc 10a): Python 3.11 + uv, Node 20
# (pinned to match the target repo's CI), git, the executor CLI (opencode),
# and glab/gh. Project dependencies are NOT installed here - they resolve at
# container runtime into the mounted cache volumes.
#
# Build:   docker build -f Dockerfile.executor -t ador-executor:latest .
# Secrets: never baked in; ADOR injects the executor's env subset at run time.
# =============================================================================

FROM ubuntu:22.04

# Pinned tool versions - bump deliberately, in one place.
ARG NODE_MAJOR=20
ARG GLAB_VERSION=1.55.0
ARG OPENCODE_PACKAGE=opencode-ai

ENV DEBIAN_FRONTEND=noninteractive

# --- Base OS tooling: git, curl, Python 3.11 (Ubuntu 22.04 universe) ---------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        gnupg \
        python3.11 \
        python3.11-venv \
    && ln -s /usr/bin/python3.11 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*

# --- Node 20 (pinned major to match the target repo's .gitlab-ci.yml) --------
RUN curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- uv (Python project tool; installs into /usr/local/bin) ------------------
RUN curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh

# --- glab (GitLab CLI; optional inside the container, baked per setup doc) ---
RUN curl -fsSL -o /tmp/glab.deb \
        "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.deb" \
    && apt-get update \
    && apt-get install -y /tmp/glab.deb \
    && rm -f /tmp/glab.deb \
    && rm -rf /var/lib/apt/lists/*

# --- gh (GitHub CLI; official apt repository) ---------------------------------
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# --- Executor CLI: opencode (via npm) -----------------------------------------
RUN npm install -g "${OPENCODE_PACKAGE}"

# --- Target-repo gate tooling (live finding 2026-07-03: `make lint`/`make
# test` are the workflow's gates and hard-require these binaries) --------------
RUN curl -fsSL https://apt.releases.hashicorp.com/gpg \
        | gpg --dearmor -o /usr/share/keyrings/hashicorp.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com jammy main" \
        > /etc/apt/sources.list.d/hashicorp.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends make shellcheck terraform unzip \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://raw.githubusercontent.com/terraform-linters/tflint/master/install_linux.sh | bash \
    && tflint --version

# --- Non-root user; mount points; git trust for bind-mounted repos ------------
# Bind mounts on Docker Desktop (Windows) show foreign ownership; without
# safe.directory git refuses to operate on the mounted repo/worktree.
RUN useradd --create-home --uid 1000 ador \
    && mkdir -p /ador/repo /ador/work /ador/io \
    && chown -R ador:ador /ador \
    && git config --system --add safe.directory '*'

USER ador
WORKDIR /ador/work

# Pin HOME to the ador user's home: some daemons (Docker Engine in WSL2)
# otherwise inject the host user's HOME into the container, breaking every
# HOME-based cache - tflint's bundled plugin, uv, npm, opencode auth (live
# finding 2026-07-04). ADOR also passes HOME explicitly at run time to
# override a daemon that injects it after this ENV.
ENV HOME=/home/ador

# Cache volume mount points (created so ownership is right before mounting):
# uv cache at /home/ador/.cache/uv, npm cache at /home/ador/.npm.
RUN mkdir -p /home/ador/.cache/uv /home/ador/.npm
ENV UV_CACHE_DIR=/home/ador/.cache/uv

# Proper CPython 3.11: Ubuntu 22.04's python3.11 apt package is stuck at
# 3.11.0rc1, so bake a uv-managed release build (into ~/.local/share/uv,
# not the runtime-mounted cache) and make uv prefer it project-wide.
RUN uv python install 3.11
ENV UV_PYTHON=3.11

# Make `python3`/`python` on PATH resolve to the uv-managed 3.11 release:
# tools like the target repo's .agentic CLI resolve `python3` and require
# 3.11+ (system /usr/bin/python3 stays 3.10 for apt). Spike finding
# 2026-07-03: the CLI refused to run on the bare image without this.
USER root
RUN target="$(ls -d /home/ador/.local/share/uv/python/cpython-3.11*/bin/python3.11 2>/dev/null | head -n1)" \
    && test -x "$target" \
    && ln -sf "$target" /usr/local/bin/python3 \
    && ln -sf "$target" /usr/local/bin/python
USER ador

# The container idles; ADOR execs the executor into it gate by gate.
CMD ["sleep", "infinity"]
